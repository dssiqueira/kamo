{
  "name": "@kamo/mcp",
  "version": "0.0.0",
  "description": "Local, read-only MCP server for your Kamo recordings. No network.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "kamo",
    "screen-recording"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "kamo-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dssiqueira/kamo.git",
    "directory": "apps/mcp"
  },
  "scripts": {
    "dev": "node --experimental-transform-types src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "inspect": "npx @modelcontextprotocol/inspector node --experimental-transform-types src/cli.ts"
  },
  "dependencies": {
    "@kamo/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
