{
  "name": "@kamo/desktop",
  "productName": "Kamo",
  "version": "0.0.0",
  "private": true,
  "description": "Kamo desktop app (Electron).",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "install-electron && electron-vite dev",
    "build": "electron-vite build",
    "preview": "install-electron && electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package": "electron-vite build && electron-builder --publish never"
  },
  "devDependencies": {
    "@kamo/core": "workspace:*",
    "@kamo/design-tokens": "workspace:*",
    "@kamo/i18n": "workspace:*",
    "@kamo/ui": "workspace:*",
    "@tailwindcss/vite": "4.3.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-updater": "6.8.11",
    "electron-vite": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.4",
    "vite": "8.3.5",
    "zod": "^4.6.7"
  }
}
