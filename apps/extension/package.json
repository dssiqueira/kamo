{
  "name": "@kamo/extension",
  "version": "0.0.0",
  "private": true,
  "description": "Kamo Chrome extension (Manifest V3).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
