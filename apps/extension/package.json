    "@kamo/i18n": "workspace:*",
    "@kamo/ui": "workspace:*",
    "@tailwindcss/vite": "4.3.4",
    "@types/chrome": "0.3.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.4",
    "vite": "8.3.5"
  }
}
