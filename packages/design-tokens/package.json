{
  "name": "@kamo/design-tokens",
  "version": "0.0.0",
  "description": "Kamo design tokens generated from DESIGN.md (CSS variables, Tailwind v4 theme and JS).",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dssiqueira/kamo.git",
    "directory": "packages/design-tokens"
  },
  "exports": {
    ".": {
      "types": "./generated/tokens.d.ts",
      "default": "./generated/tokens.js"
    },
    "./tokens.css": "./generated/tokens.css",
    "./tailwind.css": "./generated/tailwind.css",
    "./fonts.css": "./src/fonts.css",
    "./mascot/*": "./assets/mascot/*",
    "./decor/*": "./assets/decor/*"
  },
  "files": [
    "generated",
    "src/fonts.css",
    "assets"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node src/build.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0"
  },
  "devDependencies": {
    "yaml": "^2.9.1"
  }
}
